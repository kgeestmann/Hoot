# Hoot backend settings. Copy to .env in the repo root, or let
# `python backend/setup_github_app.py` create .env for you (it fills the GitHub App
# credentials and creates both keys). Every variable is explained in docs/configuration.md.

# --- Required: the backend refuses to start without these ---

# Signs the session JWTs. At least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet key that encrypts the users' GitHub tokens in the database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Your GitHub App (see docs/development.md, "GitHub App").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, as in https://github.com/apps/<slug>
GITHUB_APP_SLUG=

# --- Only for the Docker setup (docs/deployment.md) ---

# The domain Hoot is served on; Caddy gets its HTTPS certificate.
# DOMAIN=hoot.example.com

# --- Optional: the values below are the defaults ---

# GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
# FRONTEND_URL=http://localhost:4200
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# ALGORITHM=HS256
# Minutes without a request until the session ends (requests renew it).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# Days after signing in until the session ends, however active.
# SESSION_MAX_DAYS=7
# Set to false for Safari on http://localhost.
# COOKIE_SECURE=true
# DATABASE_URL=sqlite:///<repo>/backend/hoot.db
# Path prefix when a reverse proxy serves the backend under it (docker-compose.yml sets /api).
# ROOT_PATH=
